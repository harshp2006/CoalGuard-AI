# Database (Supabase PostgreSQL via asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# CORS
CORS_ORIGINS=http://localhost:5173

# Environment
ENV=development

# LLM / AI Configuration (Optional — enables RAG-powered chatbot)
# Set LLM_PROVIDER=none to disable LLM and use rule-based responses only.
# Supported providers: openai, openai-compatible, anthropic, ollama
LLM_PROVIDER=none
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=your-openai-or-anthropic-api-key
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
